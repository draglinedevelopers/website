# Keystatic CMS (GitHub mode). Created by the /keystatic setup flow — see CMS-GUIDE.md.
# Copy the real values into Vercel → Settings → Environment Variables. Never commit the real values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# GitHub usernames allowed to log in to /keystatic, comma-separated (they also need write access to the repo).
KEYSTATIC_ALLOWED_GITHUB_USERS=

# Development only: edit content/ on disk without GitHub. Never set this on Vercel.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=local
